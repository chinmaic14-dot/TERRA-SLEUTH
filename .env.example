# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NASA_FIRMS_MAP_KEY: Optional free API key from NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/area/)
# Enables high-resolution NRT VIIRS/MODIS active fire point queries. Without it, NASA EONET wildfire events and GIBS VIIRS tile layers remain active.
NASA_FIRMS_MAP_KEY=""

# NASA_EARTHDATA_TOKEN: Optional NASA Earthdata Bearer token for authenticated Harmony/AppEEARS granule downloads.
# Public NASA CMR, NASA POWER, NASA GIBS, NASA EONET, and ORNL MODIS Subset APIs work without a token.
NASA_EARTHDATA_TOKEN=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive maps across Live Earth, Geo Intelligence, and Solution Centre.
VITE_GOOGLE_MAPS_API_KEY=""
